# Lista permitida: el contexto nunca incluye .env, datos, Git ni tests locales.
**
!package.json
!package-lock.json
!next.config.ts
!tsconfig.json
!postcss.config.mjs
!instrumentation.ts
!instrumentation.node.ts
!proxy.ts
!app/
!app/**
!components/
!components/**
!hooks/
!hooks/**
!lib/
!lib/**
!public/
!public/**
!docker/
!docker/**
!scripts/
scripts/**
!scripts/postgres/
scripts/postgres/**
!scripts/postgres/001-schema.sql
!scripts/postgres/004-ajustes-portafolio.sql

# Estas exclusiones también se aplican dentro de los directorios permitidos.
**/node_modules/**
**/.next/**
**/.git/**
**/.env*
**/tests/**
**/test/**
**/__tests__/**
**/__mocks__/**
**/playwright-report/**
**/test-results/**
**/blob-report/**
**/*.test.*
**/*.spec.*
**/*.e2e-spec.*
**/*.tsbuildinfo

# datos y respaldos dentro de los directorios permitidos
**/*.log
**/*.log.*
**/logs/**
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.dump
**/*.backup
**/*.xls
**/*.xlsx
**/*.xlsm
**/*.xlsb
**/*.csv
**/*.tsv

# claves privadas y almacenes de certificados
**/*.pem
**/*.key
**/*.pfx
**/*.p12

# archivos locales del editor, temporales y copias
**/.vscode/**
**/.idea/**
**/.history/**
**/.cache/**
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
**/*.tmp
**/*.temp
**/*.bak
**/*.orig
**/*.rej
**/*.swp
**/*.swo
**/*~
**/~$*

# Datos en la raíz; las rutas de código de backups sí se incluyen.
data/**
backups/**
# Perfiles de WhatsApp, también dentro de los directorios permitidos.
**/whatsapp-session/**
**/whatsapp-sessions/**
**/.whatsapp-sesiones/**
