# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# base de datos y respaldos — nunca deben subirse, contienen data
# real de clientes y hashes de contraseñas
/data/db/*.db
/data/db/*.db-shm
/data/db/*.db-wal
/backups/

# portafolios reales del banco — data sensible de clientes
/data/portafolios/*.xlsx

/scripts/generar-data-prueba.ts
/scripts/borrar-data-prueba.ts

.whatsapp-sesiones/

scripts/limpiar-whatsapp-pruebas.mjs

whatsapp-session/
whatsapp-sessions/