# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing — los tests se conservan solo en local
/coverage
tests/
test/
__tests__/
__mocks__/
*.test.*
*.spec.*
*.e2e-spec.*
playwright-report/
test-results/
blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini

# configuración y archivos privados del editor local
.vscode/
.idea/
.history/

# claves privadas y almacenes de certificados
*.pem
*.key
*.pfx
*.p12

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.log.*
logs/

# temporales y copias locales
.cache/
*.tmp
*.temp
*.bak
*.orig
*.rej
*.swp
*.swo
*~
~$*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# datos locales y respaldos — contienen clientes y hashes de contraseñas
/data/
/backups/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.dump
*.backup

# portafolios y exportaciones, aunque se guarden fuera de /data/
*.xls
*.xlsx
*.xlsm
*.xlsb
*.csv
*.tsv

# sesiones locales de WhatsApp / Chromium
whatsapp-session/
whatsapp-sessions/
.whatsapp-sesiones/
